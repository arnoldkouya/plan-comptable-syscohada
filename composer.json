{
    "name": "arnoldkouya/plan-comptable-syscohada",
    "description": "Bibliothèque PHP complète du Plan Comptable SYSCOHADA (OHADA) — recherche, validation et navigation des comptes",
    "keywords": ["syscohada", "ohada", "comptabilité", "plan-comptable", "afrique", "accounting"],
    "homepage": "https://github.com/syscohada/plan-comptable",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Arnold KOUYA",
            "email": "arnoldkouya@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Syscohada\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Syscohada\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
